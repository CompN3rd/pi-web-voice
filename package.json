{
  "name": "@compn3rd/pi-web-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental browser-local voice interface for Pi Web",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/*.js",
    "dist/browser/*.js",
    "dist/browser/speech/ort/LICENSE",
    "dist/browser/speech/TRANSFORMERS-LICENSE",
    "dist/browser/speech/speech-pack-provenance.json",
    "dist/browser/tts/ort/LICENSE",
    "dist/browser/tts/TRANSFORMERS-LICENSE",
    "dist/browser/tts/PHONEMIZER-LICENSE",
    "dist/browser/tts/KOKORO-JS-LICENSE",
    "dist/browser/tts/ESPEAK-NG-COPYING",
    "dist/browser/tts/TTS-NOTICE.txt",
    "dist/browser/tts/TTS-QUALIFICATION.md",
    "dist/browser/tts/speech-pack-provenance.json",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-web.dev-plugin",
    "pi-web-plugin"
  ],
  "pi": {
    "extensions": [
      "./dist/companion.js"
    ]
  },
  "piWeb": {
    "plugins": [
      {
        "id": "compn3rd.voice",
        "defaultEnabled": false,
        "browserRoot": "dist/browser",
        "module": "dist/browser/index.js",
        "serverModule": "dist/server.js",
        "machineSpecific": true
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts && npm run test:assets",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:browser": "node test/browser.mjs",
    "build:speech": "node scripts/build.mjs --speech-only",
    "speech:provision": "node scripts/provision-speech-pack.mjs",
    "speech:export": "node scripts/export-speech-pack.mjs",
    "test:speech": "node --import tsx --test test/recognition-*.test.ts",
    "test:runtime": "node test/recognition-runtime-browser.mjs",
    "test:tts-runtime": "node test/tts-runtime-browser.mjs",
    "test:tts-phonemizer": "node test/tts-phonemizer-browser.mjs",
    "test:tts-model": "node test/tts-model-browser.mjs",
    "check:package": "node scripts/check-package-size.mjs",
    "test:assets": "node --test test/speech-deployment.test.mjs",
    "test:model": "npm run build && node test/recognition-model-browser.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@huggingface/transformers": "3.8.1",
    "@jmfederico/pi-web": "1.202610.3",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  }
}
